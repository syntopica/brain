#!/usr/bin/env python3
"""Run this checkout's brain CLI without changing the caller's directory."""

# This file runs under whatever python3 is first on PATH - 3.9 on stock macOS,
# where the engine itself cannot even be imported - so it must stay valid for
# old interpreters and hand over to the environment `uv sync` built.
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
cli = str(root / "tools/index/brain_cli.py")
python = str(root / ".venv/bin/python")
if os.path.exists(python):
    os.execv(python, [python, cli] + sys.argv[1:])
os.execvp("uv", ["uv", "run", "--project", str(root), "python", cli] + sys.argv[1:])
